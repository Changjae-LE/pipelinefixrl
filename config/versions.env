# PipelineFixRL — pinned versions. Single source of truth.
# Every script sources this file. Do not hand-edit digests without verifying
# them against the official upstream release notes.

# kind: newest stable at project bootstrap (2026-08-28).
# Verified from https://api.github.com/repos/kubernetes-sigs/kind/releases/tags/v0.33.0
# Release published 2026-08-26. Default node image for this release:
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

KIND_CLUSTER_NAME=pipelinefixrl

# Minimum acceptable versions for host tools (checked by scripts/doctor.sh).
HELM_MIN_VERSION=3.14.0
KUBECTL_MIN_VERSION=1.28.0
PYTHON_MIN_VERSION=3.11

# Application image.
APP_IMAGE_REPO=pipelinefixrl/app

# Deploy / evaluation defaults.
DEPLOY_TIMEOUT_SECONDS=120
RESTART_THRESHOLD=0
